ight="20" as="geometry"/></mxCell><mxCell id="lg26" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="1126" width="40" height="18" as="geometry"/></mxCell><mxCell id="t27" value=": Instance AI / Rencana Belajar / Materi" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="88" y="1125" width="300" height="20" as="geometry"/></mxCell><mxCell id="lg28" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1152" width="40" height="18" as="geometry"/></mxCell><mxCell id="t29" value=": Instance Pendukung / Notifikasi" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="88" y="1151" width="300" height="20" as="geometry"/></mxCell><mxCell id="lg30" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="1178" width="40" height="18" as="geometry"/></mxCell><mxCell id="t31" value=": Instance Integrasi LMS" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="88" y="1177" width="300" height="20" as="geometry"/></mxCell><mxCell id="t32" value="&lt;b&gt;CATATAN&lt;/b&gt;&lt;br&gt;• user1 (Andi Pratama) memiliki 2 mata kuliah (course1, course2) dan 2 tugas (task1, task2).&lt;br&gt;• task1 (prioritas high, status in_progress) milik course1; task2 (prioritas urgent, status not_started) milik course2.&lt;br&gt;• task1 punya 1 checklist, 1 catatan, 1 saran AI, 1 rencana belajar (dengan 1 item), dan 1 materi PDF (dengan 1 percobaan kuis, skor 4/5).&lt;br&gt;• log1 adalah pengingat Telegram &amp;quot;deadline_tomorrow&amp;quot; untuk task2 yang sudah terkirim (status sent).&lt;br&gt;• lms1 menghubungkan user1 ke LMS Unindra; sinkronisasi mata kuliah (sync1) berhasil dan menghasilkan lmsCourse1.&lt;br&gt;• Nilai id disingkat (mis. &amp;quot;u-001&amp;quot;) dari tipe uuid agar mudah dibaca; atribut user_id/created_at pada beberapa objek anak dihilangkan." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;strokeColor=#cccccc;spacing=8;fillColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="420" y="1048" width="1000" height="128" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>